	<!-- User Story 5: Global Component Versioning.
	     One internal version per company, channel and component. The version is
	     incremented by 1 only after an approved component change. -->
	<entity name="GlobalVersion" local-service="true" table="GlobalVersion"
			data-source="extDS" cache-enabled="false" remote-service="false">

		<column name="versionId" db-name="versionId" primary="true"
				type="long" />
		<column name="companyId" db-name="companyId" type="long" />
		<column name="channelId" db-name="channelId" type="long" />
		<column name="componentName" db-name="componentName" type="String" />
		<column name="version" db-name="version" type="long" />
		<column name="modifiedDate" db-name="modifiedDate" type="Date" />

		<!-- Unique key: UNIQUE(companyId, channelId, componentName).
		     A finder whose return-type is the entity itself makes Service
		     Builder generate a UNIQUE index for these columns. -->
		<finder return-type="GlobalVersion" name="C_C_C">
			<finder-column name="companyId" />
			<finder-column name="channelId" />
			<finder-column name="componentName" />
		</finder>

		<finder return-type="Collection" name="CompanyId">
			<finder-column name="companyId" />
		</finder>
	</entity>


