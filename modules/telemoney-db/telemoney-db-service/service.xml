			<finder-column name="channelId"></finder-column>
		</finder>

		<finder name="EntityResourceId" return-type="Collection">
			<finder-column name="entityResourceId" />
		</finder>

		<reference package-path="com.liferay.portal" entity="WorkflowInstanceLink"></reference>

	</entity>

